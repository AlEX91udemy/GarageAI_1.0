GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Use Google Cloud credentials instead of a Gemini API key when true.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional separate budgets/models; when empty, the common values above are used.
OPENROUTER_RECEIPT_API_KEY=
OPENROUTER_RECEIPT_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_DOCUMENT_API_KEY=
OPENROUTER_DOCUMENT_MODEL=minimax/minimax-m3.1-flash:free
GOOGLE_APPLICATION_CREDENTIALS=C:/path/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_RECEIPT_PROCESSOR_ID=
DOCUMENT_AI_OCR_PROCESSOR_ID=
GARAGE_DB_FILE=

# Локальный Tesseract OCR и домены production
OCR_LANGUAGES="rus+eng"
ALLOWED_ORIGINS="https://garageai.site,https://www.garageai.site,http://localhost:3000"
