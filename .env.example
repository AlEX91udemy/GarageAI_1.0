GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
# Set to 1 only when running behind the Cloud Run reverse proxy.
TRUSTED_PROXY_HOPS=0
# Use Google Cloud credentials instead of a Gemini API key when true.
# In Cloud Run, prefer the attached service identity/ADC; don't mount a service-account key file.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=europe-west1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Paid multimodal model selected for receipt and document scanning.
# Keep these explicit so a deployment never falls back to a free router.
OPENROUTER_RECEIPT_API_KEY=
OPENROUTER_RECEIPT_MODEL=google/gemini-2.5-flash
OPENROUTER_DOCUMENT_API_KEY=
OPENROUTER_DOCUMENT_MODEL=google/gemini-2.5-flash
# Optional for local development only: set GOOGLE_APPLICATION_CREDENTIALS to a local key file if ADC is unavailable.
# Never commit a service-account JSON key. Cloud Run should use its attached service identity.
# GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=your-project-id
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_RECEIPT_PROCESSOR_ID=
DOCUMENT_AI_OCR_PROCESSOR_ID=

# Production cutover gate: set true only after real-data import, backup/restore,
# tenant-isolation and Cloud Run smoke tests have passed.
GARAGE_POSTGRES_READY=
# Temporary demo override only; NEVER enable for real production data.
GARAGE_ALLOW_EPHEMERAL_STORAGE=

# Optional private Python agent service. Use the same token in Node and the agent service.
# In Cloud Run, grant the web service identity roles/run.invoker on the private agent service.
AGENTS_SERVICE_URL=
AGENTS_SERVICE_AUDIENCE=
AGENTS_API_TOKEN=
# Comma-separated admin usernames allowed to run paid agents in production; empty disables the feature.
AGENTS_ALLOWED_USERNAMES=
# Production PostgreSQL connection (prefer Cloud SQL connector/socket or Secret Manager).
# Do not set GARAGE_POSTGRES_READY=true until the cutover runbook is complete.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5
GARAGE_DB_FILE=

# Email code authentication (Resend). Keep the code secret separate from provider credentials.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_CODE_SECRET=

# Локальный Tesseract OCR и домены production
OCR_LANGUAGES="rus+eng"
ALLOWED_ORIGINS="https://garageai.site,https://www.garageai.site,http://localhost:3000"
